# Google Analytics 4
# Получите ID в Google Analytics → Admin → Data Streams → Web Stream Details
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Yandex.Metrica
# Получите ID в Yandex.Metrica → Счетчики → Код счетчика
NEXT_PUBLIC_YANDEX_ID=12345678

# reCAPTCHA Configuration
# Получите ключи на: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Development
NODE_ENV=development
